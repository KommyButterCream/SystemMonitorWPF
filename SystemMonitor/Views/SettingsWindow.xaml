<Window x:Class="SystemMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="모니터링 설정"
        Width="520"
        Height="700"
        MinWidth="460"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <DataTemplate x:Key="DeviceThresholdEditorTemplate">
            <DataTemplate.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#E2E8F0"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </DataTemplate.Resources>
            
            <Border Padding="16"
                    Margin="0,0,0,16"
                    Background="#1E293B"
                    CornerRadius="10">

                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="사용량 주의 (%)"/>

                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding UsageWarningText,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1"
                                   Text="사용량 위험 (%)"/>

                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding UsageCriticalText,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2"
                                   Text="온도 주의 (°C)"/>

                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding TemperatureWarningText,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="3"
                                   Text="온도 위험 (°C)"/>

                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding TemperatureCriticalText,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="모니터링 설정"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      IsEnabled="{Binding CanEdit}">

            <StackPanel>
                <ItemsControl
                    ItemsSource="{Binding DeviceEditors}"
                    ItemTemplate="{StaticResource DeviceThresholdEditorTemplate}"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="공통 갱신 간격 (ms)"/>

                    <TextBox Grid.Column="1"
                             ToolTip="500~5000ms, 1000ms = 1초"
                             Text="{Binding UpdateIntervalText,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock Text="적용하면 모든 장치 설정을 함께 저장합니다."
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Text="{Binding ErrorMessage}"
                   d:Text="에러 메시지가 여기에 표시됩니다."
                   Foreground="#FB7185"
                   TextWrapping="Wrap"
                   Margin="0,12,0,12"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="적용"
                    Command="{Binding ApplyCommand}"
                    IsDefault="True"/>

            <Button Content="취소"
                    Command="{Binding CancelCommand}"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>