<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:SystemMonitor.Models">

    <Style x:Key="DeviceUsageTextStyle"
           TargetType="TextBlock">

        <Setter Property="Foreground" Value="#5EEAD4"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding UsageAlertLevel}"
                         Value="{x:Static models:AlertLevel.Warning}">
                <Setter Property="Foreground" Value="#FBBF24"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding UsageAlertLevel}"
                         Value="{x:Static models:AlertLevel.Critical}">
                <Setter Property="Foreground" Value="#FB7185"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding UsageAlertLevel}"
                         Value="{x:Static models:AlertLevel.Unknown}">
                <Setter Property="Foreground" Value="#94A3B8"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DeviceUsageBarStyle"
           TargetType="ProgressBar">

        <Setter Property="Foreground" Value="#5EEAD4"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding UsageAlertLevel}"
                         Value="{x:Static models:AlertLevel.Warning}">
                <Setter Property="Foreground" Value="#FBBF24"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding UsageAlertLevel}"
                         Value="{x:Static models:AlertLevel.Critical}">
                <Setter Property="Foreground" Value="#FB7185"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding UsageAlertLevel}"
                         Value="{x:Static models:AlertLevel.Unknown}">
                <Setter Property="Foreground" Value="#94A3B8"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DeviceTemperatureTextStyle"
           TargetType="TextBlock">

        <Setter Property="Foreground" Value="#5EEAD4"/>

        <Style.Triggers>
            <DataTrigger Binding="{Binding TemperatureAlertLevel}"
                         Value="{x:Static models:AlertLevel.Warning}">
                <Setter Property="Foreground" Value="#FBBF24"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding TemperatureAlertLevel}"
                         Value="{x:Static models:AlertLevel.Critical}">
                <Setter Property="Foreground" Value="#FB7185"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding TemperatureAlertLevel}"
                         Value="{x:Static models:AlertLevel.Unknown}">
                <Setter Property="Foreground" Value="#94A3B8"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="DeviceCardTemplate">
        <Border Padding="24"
                Margin="0,0,0,16"
                Background="#1E293B"
                CornerRadius="16">

            <StackPanel>
                <TextBlock Text="{Binding DisplayName}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"/>

                <TextBlock Text="{Binding UsageText}"
                           Style="{StaticResource DeviceUsageTextStyle}"
                           FontSize="48"
                           FontWeight="Bold"
                           Margin="0,8,0,12"/>

                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding Usage, Mode=OneWay}"
                             Style="{StaticResource DeviceUsageBarStyle}"
                             Height="12"
                             Background="#334155"/>

                <TextBlock Text="{Binding UsageAlertText}"
                           Style="{StaticResource DeviceUsageTextStyle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,12,0,0"/>

                <TextBlock Text="{Binding CapacityText}"
                           FontSize="14"
                           Foreground="#CBD5E1"
                           Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                               <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CapacityText}"
                                             Value="">
                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding TemperatureLabel}"
                           FontSize="14"
                           Foreground="#CBD5E1"
                           Margin="0,20,0,4"/>

                <TextBlock Text="{Binding TemperatureText}"
                           Style="{StaticResource DeviceTemperatureTextStyle}"
                           FontSize="32"
                           FontWeight="Bold"/>

                <TextBlock Text="{Binding TemperatureAlertText}"
                           Style="{StaticResource DeviceTemperatureTextStyle}"
                           FontSize="14"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>